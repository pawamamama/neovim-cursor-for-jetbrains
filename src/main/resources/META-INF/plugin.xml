<?xml version="1.0" encoding="UTF-8"?>
<idea-plugin>
    <id>com.github.yyyolo7a79.neovidecursor</id>
    <name>Neovide Cursor</name>
    <vendor>yyyyolo7a79</vendor>

    <description><![CDATA[
    Neovide 风格「拖尾光标」—— 光标移动时留下渐隐的拉伸残影，带辉光效果。
    <br/>
    参数语义与 VS Code 版 neovide-cursor 保持一致，便于跨平台迁移配置。
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- 拖尾光标主入口：为每个编辑器挂载动画覆盖层 -->
        <editorFactoryListener implementation="com.github.yyyolo7a79.neovidecursor.ui.NeovideCaretManager"/>

        <!--
          持久化服务（application 级）

          它是 16 个可调参数的唯一持久化真相，落在
          <config>/options/NeovideCursorSettings.xml（roamingType = DISABLED：
          alwaysHighFps / glowLayers / shadowBlurFactor 是性能相关设置，不该跨机器同步）。

          注意：本文件里没有 version / idea-version 标签 —— 它们由
          build/offline-build.ps1 在打包时注入，手工往源码里加会让两处打架。
        -->
        <applicationService
            serviceImplementation="com.github.yyyolo7a79.neovidecursor.settings.NeovideCursorSettings"/>

        <!--
          设置页（application 级，挂在 Settings | Tools 下）

          parentId="tools" 是第三方插件设置的约定位置；id 必须带插件 id 前缀
          （官方原话 "The FQN should be based on the plugin id"）。

          displayName 必须写在 XML 里：Configurable.getDisplayNameFast 会优先读它，
          写不全平台为了取名字不得不先实例化类（官方原文警告 "degrades UI responsiveness"）。
        -->
        <applicationConfigurable
            parentId="tools"
            id="com.github.yyyolo7a79.neovidecursor.settings"
            displayName="Neovide Cursor"
            instance="com.github.yyyolo7a79.neovidecursor.ui.settings.NeovideCursorConfigurable"/>
    </extensions>

    <actions>
        <action id="NeovideCursor.Toggle"
                class="com.github.yyyolo7a79.neovidecursor.ui.ToggleNeovideAction"
                text="Neovide 拖尾光标（开关）"
                description="启用或禁用拖尾光标效果；关闭时会恢复原生光标">
            <add-to-group group-id="ToolsMenu" anchor="first"/>
        </action>

        <action id="NeovideCursor.PaintDiag"
                class="com.github.yyyolo7a79.neovidecursor.ui.TogglePaintDiagAction"
                text="Neovide 光标：性能诊断（禁用重绘）"
                description="跳过重绘只跑计算，用于分离瓶颈：是绘制慢还是 EDT 调度慢">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>

        <action id="NeovideCursor.TrailMode"
                class="com.github.yyyolo7a79.neovidecursor.ui.ToggleTrailModeAction"
                text="Neovide 光标：残影模式（低帧率更稳）"
                description="勾选切换到残影轨迹模型（记录真实历史位置，掉帧不失真）；取消则回到弹簧拉伸模型（Neovide 原版效果）">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>

        <!--
          隐藏原生光标（批次2 / F3 起默认勾选）

          批次2 起默认勾选 = 覆盖层充当光标本体。
          理由：本插件 alwaysHighFps 默认 true，调度恒 8ms，上游担心的
          「空闲降频导致跟随滞后」不存在；而保留原生光标时两套绘制叠加反而更重
          （用户实测「取消勾选之后卡一点」）。此处有意偏离上游踩坑 #19。

          取消勾选后回到叠加模式：原生光标由 IDE 自己绘制、零延迟跟随，
          拖尾只在移动时叠加。
        -->
        <action id="NeovideCursor.HideNativeCaret"
                class="com.github.yyyolo7a79.neovidecursor.ui.ToggleHideNativeCaretAction"
                text="Neovide 光标：隐藏原生光标（常驻绘制）"
                description="默认勾选：由覆盖层充当光标本体（不闪烁、颜色可自定义）。取消勾选则保留原生光标负责零延迟跟随，拖尾只做叠加。">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>

        <!--
          辉光淡出（批次2 / F2）

          只淡辉光，光标本体始终不透明 —— 因为默认档原生光标已隐藏，
          整体淡出会变成「光标自己消失」。
        -->
        <action id="NeovideCursor.FadeOut"
                class="com.github.yyyolo7a79.neovidecursor.ui.ToggleFadeOutAction"
                text="Neovide 光标：辉光淡出（停止后柔和熄灭）"
                description="默认勾选：拖尾停止后辉光先保持 50ms，再用 75ms 线性熄灭（只淡辉光，光标不淡）。取消勾选则辉光瞬时归零，行为与 0.9.1 一致。">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
