<?xml version="1.0" encoding="UTF-8"?>
<idea-plugin>
    <!-- 0.9.7 起：独立 fork 的 id（与上游 com.github.yyyolo7a79.neovidecursor 不冲突，可并存） -->
    <id>com.pawamamama.neovidecursor</id>
    <name>Neovide Cursor</name>
    <vendor>pawamamama</vendor>

    <description><![CDATA[
    Neovide 风格「拖尾光标」—— 光标移动时留下渐隐的拉伸残影，带辉光效果。
    <br/>
    参数语义与 VS Code 版 neovide-cursor 保持一致，便于跨平台迁移配置。
    <br/><br/>
    <b>本插件是 <a href="https://github.com/yyyyolo7a79-sketch/neovim-cursor-for-jetbrains">yyyyolo7a79-sketch/neovim-cursor-for-jetbrains</a> 的独立 fork</b>，
    由 pawamamama 维护，遵循 MIT 协议；上游原始版权声明见附带 LICENSE。
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- 拖尾光标主入口：为每个编辑器挂载动画覆盖层 -->
        <editorFactoryListener implementation="com.github.yyyolo7a79.neovidecursor.ui.NeovideCaretManager"/>

        <!--
          持久化服务（application 级）

          它是 16 个可调参数的唯一持久化真相，落在
          <config>/options/NeovideCursorSettings.xml（roamingType = DISABLED：
          alwaysHighFps / glowLayers / shadowBlurFactor 是性能相关设置，不该跨机器同步）。

          注意：本文件里没有 version / idea-version 标签 —— 它们由
          build/offline-build.ps1 在打包时注入，手工往源码里加会让两处打架。
        -->
        <applicationService
            serviceImplementation="com.github.yyyolo7a79.neovidecursor.settings.NeovideCursorSettings"/>

        <!--
          设置页（application 级，挂在 Settings | Tools 下）

          parentId="tools" 是第三方插件设置的约定位置；id 必须带插件 id 前缀
          （官方原话 "The FQN should be based on the plugin id"）。

          displayName 必须写在 XML 里：Configurable.getDisplayNameFast 会优先读它，
          写不全平台为了取名字不得不先实例化类（官方原文警告 "degrades UI responsiveness"）。
        -->
        <applicationConfigurable
            parentId="tools"
            id="com.pawamamama.neovidecursor.settings"
            displayName="Neovide Cursor"
            instance="com.github.yyyolo7a79.neovidecursor.ui.settings.NeovideCursorConfigurable"/>
    </extensions>

    <actions>
        <!--
          【0.9.6 / M1】Tools 菜单只留 3 项：常驻刷新 + 动画预设 + 颜色预设。

          其余开关（总开关 / 拖尾渲染模式 / 隐藏原生光标 / 辉光淡出 / 性能诊断）
          全部只放在 Settings | Tools | Neovide Cursor 面板里 —— 一处开关只有一个入口，
          才不会有「菜单和面板两套状态不同步」。

          ⚠️ 本条【取代】FIX-BATCH2.md:245 的「不得删除 Tools 菜单开关」：那条约束的目的
          是防功能消失，而功能现在都在面板里（用户 0.9.6 反馈明确要求菜单只留 3 项）。
        -->
        <action id="NeovideCursor.AlwaysHighFps"
                class="com.github.yyyolo7a79.neovidecursor.ui.ToggleAlwaysHighFpsAction"
                text="Neovide 光标：常驻刷新（永远 8ms）"
                description="开启后调度器不再空闲降频（约 125fps）；关掉可省电，代价是停手后第一次操作可能等一个空闲周期">
            <add-to-group group-id="ToolsMenu" anchor="first"/>
        </action>

        <!--
          动画预设 / 颜色预设 子菜单（0.9.5 / 契约 §8.4–§8.5；M1 起是菜单里的第 2、3 项）

          排在最下面（anchor="last"）：第 1 项是「开关」语义，这两项是「切换一整套值」语义；
          混排会让用户误以为预设也是开关。

          注意【必须】：<group> 里不能再列 <action> 子项 —— 子项由 DefaultActionGroup
          的构造器动态 add()。两处都列会出现重名冲突。

          class 必须是 com.intellij.openapi.actionSystem.DefaultActionGroup 的子类：
          方案原文写的 AnActionGroup 在本机 381 jar 里【不存在】（javap 实测）。
        -->

        <group id="NeovideCursor.AnimPresetGroup"
               class="com.github.yyyolo7a79.neovidecursor.ui.AnimPresetGroup"
               text="Neovide 光标：动画预设"
               popup="true">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </group>

        <group id="NeovideCursor.ColorPresetGroup"
               class="com.github.yyyolo7a79.neovidecursor.ui.ColorPresetGroup"
               text="Neovide 光标：颜色预设"
               popup="true">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </group>
    </actions>
</idea-plugin>